# --- Nextcloud (WebDAV) ---
NC_URL=https://tu-nextcloud.example.com
NC_USER=usuario
NC_APP_PASSWORD=contraseña-de-aplicacion-generada-en-nextcloud
NC_ROOT=Documentacion

# --- Auto-registro (API de provisionamiento de Nextcloud) ---
# Credenciales de un usuario admin de Nextcloud para crear cuentas nuevas.
# Sin esto el registro está deshabilitado y solo pueden entrar usuarios existentes.
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=contraseña-admin-de-nextcloud

# --- Email (SMTP para restablecer contraseña) ---
# Sin esto el botón "Olvidé mi contraseña" devuelve error 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion-gmail
SMTP_FROM=Andanzas <tu@gmail.com>

# URL pública de la app (para el enlace del email de reset).
# Ejemplo: https://tu-dominio.com/viajes
APP_URL=

# --- Servidor ---
PORT=3010
HOST=127.0.0.1

# --- Sesión ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=cambiame-minimo-32-caracteres-aleatorios
SESION_HORAS=12

# Cookie segura (HTTPS). Pon "no" solo en desarrollo local sin TLS.
COOKIE_SEGURA=yes
# Prefijo de la cookie. Ajústalo al path donde monte el proxy (p.ej. /viajes).
COOKIE_PATH=/

# --- AviationStack (consulta de vuelos en vivo) ---
# Regístrate en https://aviationstack.com para obtener una clave gratuita.
# Déjalo vacío para desactivar la consulta de vuelos.
AVIATION_API_KEY=
